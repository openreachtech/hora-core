{
  "name": "@openreachtech/hora",
  "version": "0.0.0",
  "description": "Hora Kit: a package that distributes AI skills, agents, and docs for AI-driven application development.",
  "type": "module",
  "files": [
    "dist/",
    "lib/"
  ],
  "bin": {
    "hora-core": "lib/equip/hora-core.js"
  },
